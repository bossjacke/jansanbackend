{
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/auth/register",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/auth/google-login",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/products",
      "dest": "/api/products.js"
    },
    {
      "src": "/api/products/(.+)",
      "dest": "/api/products.js"
    },
    {
      "src": "/api/users",
      "dest": "/api/users.js"
    },
    {
      "src": "/api/users/(.+)",
      "dest": "/api/users.js"
    },
    {
      "src": "/api/orders",
      "dest": "/api/orders.js"
    },
    {
      "src": "/api/cart",
      "dest": "/api/cart-chat.js"
    },
    {
      "src": "/api/chat",
      "dest": "/api/cart-chat.js"
    },
    {
      "src": "/api/payment/(.+)",
      "dest": "/api/payments.js"
    },
    {
      "src": "/api/payment",
      "dest": "/api/payments.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/webhooks/stripe",
      "dest": "/api/webhooks/stripe.js"
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ],
  "regions": ["iad1"]
}
